<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Integration tests need real credentials/network (see ClaudeInsightEngineIntegrationTests.cs), -->
    <!-- so a plain "dotnet test" excludes them by default. Opt in explicitly with dotnet test's own -->
    <!-- filter flag set to Category=Integration, which overrides this project default. -->
    <VSTestTestCaseFilter>Category!=Integration</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TuracoChorus.Adapters.Claude\TuracoChorus.Adapters.Claude.csproj" />
  </ItemGroup>

</Project>
